exports[`keeps the Meetings landing page exactly as it is 1`] = `"<div class="hp-meetings h-full flex flex-col bg-black text-white" data-testid="meetings-home"><header class="hp-clear-nav flex flex-wrap items-center gap-3 border-b border-white/[0.06] px-4 py-3 sm:px-6 sm:py-4"><div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-white/10 bg-white/[0.04]"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days text-violet-300"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path><path d="M8 14h.01"></path><path d="M12 14h.01"></path><path d="M16 14h.01"></path><path d="M8 18h.01"></path><path d="M12 18h.01"></path><path d="M16 18h.01"></path></svg></div><div class="min-w-0"><h1 class="text-lg font-semibold leading-tight sm:text-xl">Meetings</h1><p class="text-xs text-white/50 sm:text-sm">All meetings in one place</p></div><div class="ml-auto flex items-center gap-2"><button type="button" aria-label="New Meeting" title="New Meeting" class="inline-flex h-10 items-center gap-2 rounded-xl bg-gradient-to-r from-fuchsia-600 to-violet-600 px-3 text-sm font-semibold shadow-lg shadow-fuchsia-900/30 hover:from-fuchsia-500 hover:to-violet-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fuchsia-300 sm:px-4"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> <span class="hidden sm:inline">New Meeting</span></button><button type="button" aria-label="Import Files" title="Import Files" class="inline-flex h-10 items-center gap-2 rounded-xl border border-teal-