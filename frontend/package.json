{
  "name": "homepilot-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "prebuild": "node scripts/generate-model-catalog.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog": "node scripts/generate-model-catalog.mjs",
    "catalog:check": "node scripts/generate-model-catalog.mjs --check"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.11",
    "lucide-react": "^0.457.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "6.2.3",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "axe-core": "^4.13.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^4.0.18"
  }
}
