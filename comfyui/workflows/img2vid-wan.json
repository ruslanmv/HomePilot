{
  "_meta": {
    "title": "Wan 2.2 5B Image to Video",
    "description": "Image-to-video with Wan 2.2 TI2V 5B, the lighter Spicy video model for 12-16 GB cards. The uploaded image is the first frame.",
    "optimal_settings": {
      "resolution": "1280x704 or 704x1280 (multiples of 32)",
      "frames": "81 or 121 (4n+1)",
      "cfg": "5.0",
      "steps": "30",
      "fps": "24"
    },
    "requirements": [
      "diffusion_models/wan2.2_ti2v_5B_fp16.safetensors",
      "text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "vae/wan2.2_vae.safetensors"
    ],
    "fixed": "The earlier version loaded files the catalog pack never installs (a GGUF T5 and wan_2.2_vae.safetensors) through DualCLIPLoader, and sampled an empty latent, so the uploaded image was ignored. It now loads exactly the pack's three files and starts from the image via Wan22ImageToVideoLatent."
  },
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image_path}}"
    }
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
      "weight_dtype": "default"
    }
  },
  "3": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["2", 0],
      "shift": 8.0
    }
  },
  "4": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan"
    }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan2.2_vae.safetensors"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["4", 0]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": ["4", 0]
    }
  },
  "8": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {
      "vae": ["5", 0],
      "width": "{{width}}",
      "height": "{{height}}",
      "length": "{{frames}}",
      "batch_size": 1,
      "start_image": ["1", 0]
    }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["3", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["8", 0]
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["5", 0]
    }
  },
  "11": {
    "class_type": "SaveAnimatedWEBP",
    "inputs": {
      "images": ["10", 0],
      "fps": "{{fps}}",
      "lossless": false,
      "quality": 85,
      "method": "default",
      "filename_prefix": "wan_video"
    }
  }
}
